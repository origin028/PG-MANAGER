# Application Environment
ENVIRONMENT=development
PROJECT_NAME="PG Management System API"
API_V1_STR=/api/v1
DEBUG=true

# Security & JWT Secrets (Change these in production!)
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL with Psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Note: Special characters in passwords (e.g. '@', ':', '/') must be URL-encoded (e.g. '@' as '%40').
DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/pg_management

# CORS Allowed Origins (Comma-separated)
# Allows Flutter Web dev server (localhost:8080, localhost:5000, etc.) and mobile clients
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8080","http://localhost:8081","http://127.0.0.1:8080","http://127.0.0.1:3000","*"]

# Registration OTP
# The code is hashed before storage; only these knobs control its lifetime and limits.
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Transactional email (registration OTP delivery)
# Delivery is only attempted when EMAIL_ENABLED=true AND SMTP_HOST/EMAIL_FROM are set.
# When disabled, /auth/register still succeeds but reports email_sent=false.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Logging
LOG_LEVEL=INFO
