# Application Environment
ENVIRONMENT=development
PROJECT_NAME="PG Management System API"
API_V1_STR=/api/v1
DEBUG=true

# Security & JWT Secrets (Change these in production!)
SECRET_KEY=change-me-super-secret-key-minimum-32-characters-origin-pg-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL with Psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pg_management_db

# Local fallback: set to sqlite:///./pg_management.db for quick local development if postgres is offline
# DATABASE_URL=sqlite:///./pg_management.db

# CORS Allowed Origins (Comma-separated)
# Allows Flutter Web dev server (localhost:8080, localhost:5000, etc.) and mobile clients
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8080","http://localhost:8081","http://127.0.0.1:8080","http://127.0.0.1:3000","*"]

# Logging
LOG_LEVEL=INFO
