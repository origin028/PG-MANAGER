{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "services": {
    "frontend": {
      "root": "pg-management-system/frontend",
      "framework": "vite"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/api/$1"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "api",
        "path": "/docs"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "api",
        "path": "/openapi.json"
      }
    },
    {
      "source": "/admin/(assets/.*|icons/.*|canvaskit/.*|main\\.dart\\.js|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js|version\\.json|manifest\\.json|favicon\\.png)",
      "destination": {
        "service": "frontend",
        "path": "/admin/$1"
      }
    },
    {
      "source": "/admin/?$",
      "destination": {
        "service": "frontend",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/admin/((?!assets/|icons/|canvaskit/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": {
        "service": "frontend",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/(dashboard|properties|rooms|residents|payments|complaints|expenses|staff|leads|reports|food-menu|settings|login|register|splash)(/.*)?",
      "destination": {
        "service": "frontend",
        "path": "/admin/index.html"
      }
    },
    {
      "source": "/pay(/.*)?",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/((?!api/|docs|openapi\\.json|admin/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(assets|canvaskit|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(main\\.dart\\.js|flutter\\.js|flutter_bootstrap\\.js|flutter_service_worker\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
