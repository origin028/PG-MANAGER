# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="PG Management System API"
API_V1_STR=/api/v1

# Security & JWT Configuration
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Common Super Key for PG Owner Administrator Registration (shared by Origin Company)
ADMIN_REGISTRATION_SUPER_KEY=your_origin_admin_super_key_here

# Database Configuration (PostgreSQL 16+ via Psycopg 3 binary driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/pg_management

# Razorpay (keep secrets outside source control; online payments remain disabled when absent)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API. Use approved templates for payment links/receipts.
WHATSAPP_PROVIDER=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PAYMENT_TEMPLATE=
WHATSAPP_RECEIPT_TEMPLATE=

# Public Base URL for resident self-checkout links (sent via WhatsApp)
# Example: https://checkout.yourdomain.com/pay or http://localhost:3000/pay
PAYMENT_LINK_BASE_URL=https://checkout.example.com/pay

# Direct UPI Rent Payment Configuration (No Payment Gateway)
# Configured business UPI ID (VPA) and Payee Name for Google Pay and PhonePe direct intent flows
UPI_PAYEE_VPA=your_business_vpa@upi
UPI_PAYEE_NAME="Your Business Name"
UPI_MERCHANT_CODE=
# Secret token for authenticating trusted direct bank webhook callbacks
UPI_BANK_WEBHOOK_SECRET=
# Bank direct API credentials for automated status verification (when bank integration is active)
UPI_VERIFICATION_PROVIDER_URL=
UPI_BANK_API_KEY=

# Email & SMTP Configuration (Resident OTP Delivery)
# Set EMAIL_PROVIDER=SMTP for actual email OTP delivery, or MOCK for development logs
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USERNAME (or SMTP_USER for backward compatibility)
SMTP_USERNAME=your_email@gmail.com
SMTP_USER=your_email@gmail.com
# For Gmail, generate a 16-character App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="PG Management"
# SMTP_USE_TLS (or SMTP_TLS for backward compatibility): true for port 587 (STARTTLS), or port 465 (Direct SSL)
SMTP_USE_TLS=true
SMTP_TLS=true

# CORS Origins (JSON list or comma-separated URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8081","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# Logging
LOG_LEVEL=INFO
