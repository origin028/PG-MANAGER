# Copy to apps/api/.env for local development. NEVER commit a real .env.
# ---- Environment: development | test | production ------------------------------------
# If ENVIRONMENT is unset the API assumes production and refuses to boot without real secrets.
ENVIRONMENT=development
DEBUG=true

# ---- Database (local docker-compose or Homebrew Postgres) ----------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pg_management

# ---- Secrets (optional in development; REQUIRED in production) -----------------------
# SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(64))"
# ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing ENCRYPTION_KEY makes stored KYC documents unreadable - back it up separately.
SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_REGISTRATION_SUPER_KEY=dev-owner-key

# ---- Web clients allowed to call the API (comma separated, no wildcard) --------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Email: SMTP only (Gmail / Google Workspace / any relay) -------------------------
# Development default prints OTPs to the log instead of sending mail.
EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Origin PG Living
SMTP_USE_TLS=true

# ---- Business rules -----------------------------------------------------------------
DEPOSIT_REFUND_PERCENT=50
RENT_DUE_DAY=5

# ---- Fingerprint machine bridge -----------------------------------------------------
ATTENDANCE_DEVICE_KEY=

# ---- Payments (unchanged) -----------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=AUTO
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
